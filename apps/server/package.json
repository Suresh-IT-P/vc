{
  "name": "@sonder/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/with-env.mjs node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node ../../scripts/with-env.mjs prisma generate",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate dev",
    "db:migrate:deploy": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "db:push": "node ../../scripts/with-env.mjs prisma db push",
    "db:studio": "node ../../scripts/with-env.mjs prisma studio",
    "db:seed": "node ../../scripts/with-env.mjs tsx prisma/seed.ts",
    "db:reset": "node ../../scripts/with-env.mjs prisma migrate reset --force && node ../../scripts/with-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@sonder/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.2.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
