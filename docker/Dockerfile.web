# ---------------------------------------------------------------------------
# Sonder web app (Next.js standalone output).
#
# NEXT_PUBLIC_* values are inlined at build time, so they are build args rather
# than runtime environment: changing the API URL means rebuilding this image.
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
COPY apps/server/package.json apps/server/
RUN npm ci --workspace @sonder/web --workspace @sonder/shared --include-workspace-root

FROM deps AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL
ENV NEXT_TELEMETRY_DISABLED=1
# Opt in to .next/standalone. It is off by default so that a local
# `npm run build && npm start` works without Next warning about it; the runtime
# stage below is the only consumer, and it copies standalone/ explicitly.
ENV BUILD_STANDALONE=true
COPY tsconfig.base.json ./
COPY scripts scripts
COPY packages/shared packages/shared
COPY apps/web apps/web
# Builds the shared package, then the AudioWorklet bundle, then the app. The
# worklet MUST be generated before `next build` copies public/ into the image.
RUN npm run build --workspace @sonder/shared \
 && node scripts/build-worklet.mjs \
 && npm run build --workspace @sonder/web

FROM node:22-alpine AS runtime
WORKDIR /app
RUN addgroup -S sonder && adduser -S sonder -G sonder
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1

COPY --from=build --chown=sonder:sonder /app/apps/web/.next/standalone ./
COPY --from=build --chown=sonder:sonder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=sonder:sonder /app/apps/web/public ./apps/web/public

USER sonder
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
